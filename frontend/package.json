{
  "name": "commerce-analysis-agent-frontend",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:e2e": "playwright test",
    "format": "prettier --write src e2e *.ts *.json *.yaml",
    "format:check": "prettier --check src e2e *.ts *.json *.yaml"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "antd": "^5.26.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "3.6.2",
    "typescript": "^5.8.0",
    "vite": "^7.3.1"
  },
  "packageManager": "pnpm@11.25.0"
}
