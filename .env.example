# Copy to .env. Defaults are for LOCAL DEMO ONLY.
APP_ENV=development
AGENT_MODE=demo
DATABASE_URL=sqlite:///.data/commerce.db
DATA_DIR=.data
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8080","http://127.0.0.1:8080"]
SESSION_SECRET=local-demo-only-change-before-deployment
BOOTSTRAP_EMAIL=demo@example.com
BOOTSTRAP_PASSWORD=demo-commerce-2026
COOKIE_SECURE=false
SEED_DEMO=true

# live mode requires a tool-calling and structured-output compatible model.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
# HTTP inactivity timeouts, not the total task deadline. No automatic model retries.
MODEL_READ_TIMEOUT_SECONDS=60
MODEL_CONNECT_TIMEOUT_SECONDS=5
TAVILY_API_KEY=
KNOWLEDGE_PROVIDER=local
RAGFLOW_API_URL=
RAGFLOW_API_KEY=
# Dataset access is explicitly mapped by tenant; never search all remote datasets.
RAGFLOW_DATASETS={}
SEMANTIC_REVIEW=true
INPUT_PRICE_PER_MILLION=
OUTPUT_PRICE_PER_MILLION=

MAX_TOOL_CALLS=16
MAX_MODEL_CALLS=12
MAX_TOKENS=60000
MAX_RUNTIME_SECONDS=180
MAX_ACTIVE_TASKS=3
WORKER_CONCURRENCY=2
LEASE_SECONDS=30
MAX_ATTEMPTS=3

# Docker local demo; use unique URL-safe secrets before deployment.
POSTGRES_PASSWORD=local-demo-admin-password
APP_DB_PASSWORD=local-demo-app-password
WEB_PORT=8080
# These fixed proxy hops must be distinct and inside the selected unused subnet.
COMMERCE_NETWORK_SUBNET=172.30.0.0/24
COMMERCE_FRONTEND_IP=172.30.0.10
COMMERCE_INGRESS_IP=172.30.0.11
# production.yaml requires DOMAIN and HTTPS origins, plus secure application credentials.
DOMAIN=
